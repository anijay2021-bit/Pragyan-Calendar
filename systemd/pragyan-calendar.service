[Unit]
Description=Pragyan Calendar - AngelOne index calendar spread agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/venv/bin/python main.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
