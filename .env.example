# ---- AngelOne SmartAPI (required) -------------------------------------
# Create an API key at https://smartapi.angelbroking.com/ (Trading API).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret from the QR shown when enabling TOTP - not the 6-digit code.
ANGEL_TOTP_SECRET=

# ---- Trading mode -----------------------------------------------------
# PAPER = simulate only. LIVE = place real orders. Start on PAPER.
TRADING_MODE=PAPER

# ---- Telegram alerts (optional) ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard login --------------------------------------------------
# The dashboard refuses to serve until DASH_PASS is set.
DASH_USER=admin
DASH_PASS=
